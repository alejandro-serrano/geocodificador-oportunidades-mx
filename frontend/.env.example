# Copia este archivo como .env.local si vas a usar `npm run dev`.
#
# CUÁNDO HACE FALTA
#
#   npm run dev      Sí. El frontend corre en el 5173 y el backend en el 8000,
#                    así que hay que decirle dónde está.
#
#   npm run build    No. El build se guarda en backend/static/ y Flask lo sirve
#                    desde su mismo puerto, así que las rutas relativas bastan.
#                    Ese es también el motivo de que la app funcione desde el
#                    teléfono sin configurar nada.

VITE_API_BASE=http://localhost:8000

# Para desarrollar viendo los cambios en el teléfono, usa la IP local del Mac
# en vez de localhost (api.py la imprime al arrancar):
#
# VITE_API_BASE=http://192.168.1.10:8000
